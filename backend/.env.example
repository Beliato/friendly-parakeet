# Base de datos (Railway lo genera automaticamente como DATABASE_URL)
# Puerto host 5433 para no chocar con el Postgres de FinTrack (5432)
DATABASE_URL=postgresql://julia:julia123@localhost:5433/julia

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia-esto-por-un-secreto-seguro-de-al-menos-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS — URL del frontend en produccion (sin trailing slash)
CORS_ORIGINS=http://localhost:3000

# Cloudflare R2 (storage de fotos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Produccion: DEBUG=false activa validaciones de seguridad en JWT_SECRET
DEBUG=true
